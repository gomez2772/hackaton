# Copia este archivo a .env y rellena tus valores. .env NUNCA se sube al repo.

# --- Tu rol en el equipo: A (UI/API/export) · B (motor LLM) · C (audio/datos/cálculo) · D (QA)
ACTA_ROL=

# --- Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 = cachea respuestas del LLM en disco por hash de entrada (ahorra tokens en desarrollo)
ACTA_LLM_CACHE=1

# --- ElevenLabs (plan Creator, presupuesto compartido ~130 000 créditos)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ADVISOR=
ELEVENLABS_VOICE_CLIENT=
# 1 = usa Whisper local si ElevenLabs falla
ACTA_STT_FALLBACK=0

# --- Modo simulado: etapas que devuelven el fixture (stt,extract,check,report o all)
ACTA_FAKE_STAGES=

# --- Varios
ACTA_CACHE_DIR=.cache
ACTA_API_KEY=dev-key
ACTA_ADVISOR_NAME=Asesor de demostración
