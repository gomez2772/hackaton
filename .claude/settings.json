{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git switch:*)", "Bash(git checkout:*)",
      "Bash(git branch:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git rebase:*)", "Bash(git diff:*)",
      "Bash(git log:*)", "Bash(git stash:*)", "Bash(git rev-parse:*)", "Bash(git merge-base:*)",
      "Bash(git push -u origin a/:*)", "Bash(git push -u origin b/:*)", "Bash(git push -u origin c/:*)", "Bash(git push -u origin d/:*)",
      "Bash(git push origin a/:*)", "Bash(git push origin b/:*)", "Bash(git push origin c/:*)", "Bash(git push origin d/:*)",
      "Bash(git push --force-with-lease origin a/:*)", "Bash(git push --force-with-lease origin b/:*)",
      "Bash(git push --force-with-lease origin c/:*)", "Bash(git push --force-with-lease origin d/:*)",
      "Bash(gh pr:*)", "Bash(gh auth status:*)", "Bash(gh run:*)",
      "Bash(python -m pytest:*)", "Bash(python3 -m pytest:*)", "Bash(pytest:*)",
      "Bash(ruff:*)", "Bash(python tools/:*)", "Bash(python3 tools/:*)",
      "Bash(python -m app.pipeline:*)", "Bash(python3 -m app.pipeline:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)", "Bash(git push -f:*)", "Bash(git push --force:*)",
      "Bash(git reset --hard:*)", "Bash(git clean -fd:*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$CLAUDE_PROJECT_DIR/tools/guard_edit.py\""
          }
        ]
      }
    ]
  }
}
